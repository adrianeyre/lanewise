{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lanewise",
  "version": "../package.json",
  "identifier": "com.adrianeyre.lanewise",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5150",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lanewise",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Adrian Eyre",
    "homepage": "https://github.com/adrianeyre/lanewise",
    "license": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "A free, open-source Git client with a visual commit graph",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/adrianeyre/lanewise/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
